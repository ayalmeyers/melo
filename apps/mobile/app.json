{
  "expo": {
    "name": "Melo",
    "slug": "melo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "melo",
    "userInterfaceStyle": "light",
    "backgroundColor": "#070910",
    "ios": {
      "bundleIdentifier": "com.meyerslink.melo",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "spotify",
          "music"
        ]
      },
      "associatedDomains": []
    },
    "android": {
      "package": "com.meyerslink.melo",
      "adaptiveIcon": {
        "backgroundColor": "#070910",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070910",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#047eef"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f4253c2b-99e0-4996-bb04-ba7e36ea1cbf"
      }
    },
    "owner": "ayalmeyers",
    "updates": {
      "url": "https://u.expo.dev/f4253c2b-99e0-4996-bb04-ba7e36ea1cbf"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
